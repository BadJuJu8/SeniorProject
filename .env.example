# Copy to .env (gitignored) and fill in for local CI runs. In Gitea, set these as
# repository Variables (non-secret URLs/users) and Secrets (passwords) instead — see
# .gitea/workflows/detect.yml. Existing environment variables always override .env.

# --- Wazuh manager API (unit test / logtest, port 55000) ---
WAZUH_MANAGER_URL=https://127.0.0.1:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=change-me

# --- Wazuh indexer API (integration test / _search, port 9200) ---
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=change-me
WAZUH_ALERTS_INDEX=wazuh-alerts-*

# --- TLS ---
# Lab uses self-signed certs; leave false. To verify, set true and point at a CA bundle.
WAZUH_VERIFY_TLS=false
# WAZUH_CA_BUNDLE=/etc/wazuh/root-ca.pem
